# Copy to .env, edit, then `chmod 600 .env`. Never commit .env (commit only this example).

# Webtop login (use a long random password)
WEBTOP_USER=TeXBundle
WEBTOP_PASSWORD=TeXBundle

# Host folder shared with the container (appears as ~/Projects inside)
# Windows tip: keep it inside WSL for speed; from PowerShell use forward slashes (C:/Users/you/projects)
PROJECTS_DIR=./test-shared-folder

# Ownership of files created in the shared folder
#   1000/1000 : Linux rootful Docker (use `id -u` / `id -g`), macOS, Windows/WSL
#   0/0       : Linux rootless Docker
PUID=1000
PGID=1000
TZ=Etc/UTC

# Build options (match the Dockerfile ARGs)
WEBTOP_TAG=ubuntu-lxqt
INSTALLATION_TYPE=full

# Resource limits
MEM_LIMIT=4g
CPUS=2
PIDS_LIMIT=512

# Wallpaper file placed in ./customization/ (svg, png or jpg)
WALLPAPER_FILE=wallpaper.svg